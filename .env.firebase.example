# Firebase Storage bucket shown in Firebase Console > Storage.
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Optional; this is the default object prefix.
FIREBASE_MODEL_PREFIX=models

# Local publishing only. Download a service-account JSON file, keep it outside
# the repository, and set this to its absolute path.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json
